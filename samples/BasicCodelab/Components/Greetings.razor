<div class="py-1">
    <Virtualize Items="@Names" Context="name" ItemSize="80">
        <Greeting Name="@name" />
    </Virtualize>
</div>

@code {
    [Parameter]
    public required List<string> Names { get; set; } = Enumerable
        .Range(0, 1000)
        .Select(i => $"{i}")
        .ToList();
}
