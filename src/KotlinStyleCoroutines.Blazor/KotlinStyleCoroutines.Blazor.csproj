<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>KotlinStyleCoroutines.Blazor</PackageId>
    <Version>0.1.0</Version>
    <Authors>KotlinStyleCoroutines Contributors</Authors>
    <Description>Jetpack Compose-style lifecycle bindings (LifecycleComponentBase, CollectAsStateWithLifecycle, LaunchedEffect, ProduceState) for Blazor built on KotlinStyleCoroutines.</Description>
    <PackageTags>blazor;coroutines;structured-concurrency;flow;stateflow;sharedflow;jetpack-compose;dotnet11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nabond251/KotlinStyleCoroutines</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nabond251/KotlinStyleCoroutines</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KotlinStyleCoroutines/KotlinStyleCoroutines.csproj" />
  </ItemGroup>

</Project>
