<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KotlinStyleCoroutines</RootNamespace>
    <AssemblyName>KotlinStyleCoroutines</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>KotlinStyleCoroutines</PackageId>
    <Version>0.1.0</Version>
    <Authors>KotlinStyleCoroutines Contributors</Authors>
    <Description>Kotlin-style structured concurrency (CoroutineScope, Job, Deferred, Dispatchers, WithContext), cancellable continuations, and hot/cold Flow operators (StateFlow, SharedFlow, ChannelFlow, FlatMapLatest, Debounce, Sample, RetryWhen) for .NET 11.</Description>
    <PackageTags>kotlin;coroutines;structured-concurrency;flow;stateflow;sharedflow;async;dotnet11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nabond251/KotlinStyleCoroutines</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nabond251/KotlinStyleCoroutines</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
