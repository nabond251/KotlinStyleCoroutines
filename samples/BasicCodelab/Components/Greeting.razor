@inject Microsoft.Extensions.Localization.IStringLocalizer<Greeting> Localizer

<article class="card shadow-sm mx-2 my-1 greeting-card">
    <div class="card-body d-flex align-items-start p-4">
        <div class="flex-grow-1">
            <div>Hello, </div>
            <div class="fs-4 fw-bolder">@Name</div>
            <div class="greeting-extra @(IsExpanded ? "expanded" : null)" aria-hidden="@(!IsExpanded)">
                <div class="greeting-extra-content">
                    Compose makes it easy to build beautiful interfaces. Expand this card to see its content adapt to the layout.
                </div>
            </div>
        </div>
        <button type="button"
                class="btn btn-light rounded-circle shadow-sm ms-2"
                aria-label="@Localizer[IsExpanded ? "ShowLess" : "ShowMore"]"
                aria-expanded="@IsExpanded"
                title="@Localizer[IsExpanded ? "ShowLess" : "ShowMore"]"
                @onclick="ToggleExpanded">
            @if (IsExpanded)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
                </svg>
            }
        </button>
    </div>
</article>

@code {
    private bool IsExpanded { get; set; }

    private void ToggleExpanded() => IsExpanded = !IsExpanded;

    [Parameter]
    public required string Name { get; set; }
}
