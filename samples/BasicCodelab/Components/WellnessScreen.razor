@inherits LifecycleComponentBase
@using BasicCodelab.Models
@using KotlinStyleCoroutines.Blazor
@inject WellnessViewModel ViewModel

<div class="container py-3">
    <h1 class="h3">Wellness</h1>

    <StatefulCounter />

    <section aria-labelledby="tasks-heading">
        <h2 id="tasks-heading" class="h5 mt-3">Daily tasks</h2>
        <WellnessTasksList Tasks="@_uiState.Value.Tasks"
                           OnCheckedTask="HandleCheckedTask"
                           OnCloseTask="HandleCloseTask" />
    </section>
</div>

@code {
    private FlowState<WellnessUiState> _uiState = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _uiState = CollectAsStateWithLifecycle(ViewModel.UiState, pauseWhenTabHidden: false);
    }

    private void HandleCheckedTask((WellnessTask Task, bool IsChecked) change) =>
        ViewModel.ChangeTaskChecked(change.Task, change.IsChecked);

    private void HandleCloseTask(WellnessTask task) => ViewModel.Remove(task);
}
