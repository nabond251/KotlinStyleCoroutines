<div class="mx-2 my-1" style="background-color: var(--color-primary); color: var(--color-on-primary);">
    <div class="d-flex align-items-center p-4">
        <div class="flex-grow-1 greeting-details @(IsExpanded ? "expanded" : null)">
            <div>Hello, </div>
            <div class="fs-4 fw-bolder">@Name</div>
        </div>
        <button type="button" class="btn btn-light shadow" @onclick="ToggleExpanded">
            @(IsExpanded ? "Show less" : "Show more")
        </button>
    </div>
</div>

@code {
    private bool IsExpanded { get; set; }

    private void ToggleExpanded() => IsExpanded = !IsExpanded;

    [Parameter]
    public required string Name { get; set; }
}
